    EMPRESA {
        uuid id PK
        string nombre
        string rfc
        string estado
    }
    CLIENTE {
        uuid id PK
        uuid tenant_id FK
        string nombre
        string rfc
        boolean activo
        bigint version
    }
    COTIZACION {
        uuid id PK
        uuid tenant_id FK
        uuid cliente_id FK
        string estado
        numeric total
        bigint version
    }
    PARTIDA_COTIZACION {
        uuid id PK
        uuid cotizacion_id FK
        int cantidad
        numeric precio_unitario
        numeric subtotal
    }
    FACTURA {
        uuid id PK
        uuid tenant_id FK
        uuid cliente_id FK
        numeric subtotal
        numeric iva
        numeric retenciones
        numeric total
        string estado
        uuid folio_fiscal
    }
    POLIZA_CONTABLE {
        uuid id PK
        uuid tenant_id FK
        string tipo
        boolean inmutable
    }
    MOVIMIENTO_POLIZA {
        uuid id PK
        uuid poliza_id FK
        uuid cuenta_id FK
        numeric cargo
        numeric abono
    }