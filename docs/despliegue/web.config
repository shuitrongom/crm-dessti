<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  web.config del sitio "CRM" (frontend Angular) - Dess-TI / plataforma-multigiro
  ............................................................................
  Ubicacion en el servidor: C:\inetpub\wwwroot\crm\web.config

  Requisitos del servidor para que este archivo funcione:
    * IIS con el modulo URL Rewrite instalado.
    * IIS con el modulo ARR (Application Request Routing) instalado y con el
      "Enable proxy" ACTIVADO a nivel del servidor (ver la guia, Paso 4).

  Que hace este archivo:
    1) PROXY INVERSO de /api  hacia  http://127.0.0.1:8080/api  (backend Spring).
       Se preserva la ruta completa (incluido /api/v1). Se anaden las cabeceras
       X-Forwarded-Proto=https y X-Forwarded-Host; ARR agrega X-Forwarded-For.
    2) FALLBACK de SPA: cualquier peticion que NO sea un archivo/carpeta real y
       que NO empiece por /api se reescribe a /index.html, para que el
       enrutado del lado del cliente de Angular funcione al recargar (F5).

  ORDEN DE REGLAS (IMPORTANTE):
    * Primero la regla del PROXY de API (stopProcessing=true).
    * Despues la regla de FALLBACK de la SPA.
    Si se invirtiera el orden, /api caeria en el index.html y nunca llegaria al
    backend.

  Nota sobre la redireccion a HTTPS: se gestiona a nivel del sitio (binding o
  regla dedicada, ver la guia) para NO interferir con el proxy de ARR. Aqui se
  deja comentada una regla opcional; activela solo si entiende su efecto.
  ============================================================================
-->
<configuration>
  <system.webServer>

    <!--
         Reglas de reescritura (URL Rewrite + ARR)
    -->
    <rewrite>
      <rules>

        <!--
             REGLA 1 . Proxy inverso de la API hacia el backend local.
             Captura TODO lo que empiece por "api/" y lo reenvia al backend
             en 127.0.0.1:8080 conservando el resto de la ruta ({R:1}).
             stopProcessing=true: si coincide, NO se evaluan mas reglas.
        -->
        <rule name="Proxy API al backend" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/api/{R:1}" />
          <serverVariables>
            <!-- El cliente llego por HTTPS (IIS termina TLS). Se lo indicamos
                 al backend para que reconstruya URLs https y emita HSTS. -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <!-- Host original solicitado por el cliente (DDNS con puerto). -->
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>

        <!--
             REGLA 2 . Fallback de la SPA (Angular).
             Si la peticion NO es un archivo real (isFile) ni un directorio
             real (isDirectory), se reescribe a /index.html. Asi las rutas
             del lado del cliente (p. ej. /login, /empresas) funcionan al
             recargar la pagina. La regla 1 ya desvio /api antes de llegar
             aqui, de modo que el backend nunca cae en el index.html.
        -->
        <rule name="Fallback SPA Angular" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api(/|$)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

        <!--
             REGLA OPCIONAL (DESACTIVADA) . Redirigir HTTP a HTTPS.
             Deje esto comentado si gestiona la redireccion con un binding o
             una regla a nivel de sitio. Si la activa, verifique que NO rompe
             el proxy de ARR (debe evaluarse ANTES de las reglas anteriores).

             <rule name="Redirigir a HTTPS" stopProcessing="true">
               <match url="(.*)" />
               <conditions>
                 <add input="{HTTPS}" pattern="off" ignoreCase="true" />
               </conditions>
               <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
             </rule>
        -->

      </rules>
    </rewrite>

    <!--
         Tipos MIME. IIS ya conoce la mayoria; se declaran los usados por el
         build de Angular por si el servidor no los tuviera registrados.
         "remove" antes de "add" evita el error HTTP 500.19 por duplicado.
    -->
    <staticContent>
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".ico" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />
    </staticContent>

    <!--
         Cache OPCIONAL para activos con hash en el nombre (chunk-XXXX.js,
         styles-XXXX.css). Angular versiona el nombre en cada build, por lo
         que es seguro cachearlos por mucho tiempo. index.html NO se cachea
         para que el navegador siempre reciba la version mas reciente.
         Si prefiere no tocar la cache, puede eliminar este bloque.
    -->
    <caching>
      <profiles>
        <add extension=".js" policy="CacheForTimePeriod" kernelCachePolicy="CacheForTimePeriod" duration="30.00:00:00" />
        <add extension=".css" policy="CacheForTimePeriod" kernelCachePolicy="CacheForTimePeriod" duration="30.00:00:00" />
        <add extension=".woff2" policy="CacheForTimePeriod" kernelCachePolicy="CacheForTimePeriod" duration="30.00:00:00" />
      </profiles>
    </caching>

    <!--
         Compresion estatica y dinamica (mejora tiempos de carga del SPA).
    -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

  </system.webServer>
</configuration>
